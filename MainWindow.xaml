<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="520" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False">

    <Window.Resources>
        <!-- Colours that the Settings window can change at runtime -->
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubBrush" Color="#B3FFFFFF" />

        <!-- Volume slider pieces -->
        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" Height="16">
                            <Border Height="3" CornerRadius="1.5"
                                    Background="{DynamicResource TextBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderEmptyButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" Height="16" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource TextBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="#FF48484A"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFillButton}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmptyButton}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact play/pause: just the icon, no outline or background -->
        <Style x:Key="PlainIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat round icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="18" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Invisible 10 px halo around the island: it catches clicks on, or just outside, the border
         so the progress border is easy to hit. All mouse handling lives here. -->
    <Border x:Name="Halo" Background="#01000000" Padding="6,8,6,6"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            PreviewMouseLeftButtonDown="Island_PreviewMouseDown"
            MouseWheel="Island_MouseWheel"
            MouseMove="Island_MouseMove"
            PreviewMouseLeftButtonUp="Island_PreviewMouseUp"
            LostMouseCapture="Island_LostCapture">

    <!-- The "island" -->
    <Border x:Name="Island"
            Background="Black"
            Width="240" Height="46"
            CornerRadius="23"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            SnapsToDevicePixels="True"
            Opacity="0.8"
            SizeChanged="Island_SizeChanged">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Settings…" Click="Settings_Click" />
                <Separator />
                <MenuItem Header="Exit Dynamic Island" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- ============ COMPACT VIEW ============ -->
            <StackPanel x:Name="CompactPanel"
                        Orientation="Horizontal" MinHeight="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CompactDate" Text="Mon, 1 Jan"
                           Foreground="{DynamicResource SubBrush}" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text="&#x2022;" Foreground="{DynamicResource SubBrush}" FontSize="10"
                           Margin="7,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CompactTime" Text="00:00"
                           Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Right side. Shown only while media is playing / paused: play-pause icon + audio visualizer -->
                <StackPanel x:Name="CompactMedia" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="60,0,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="CompactPlayBtn" Style="{StaticResource PlainIconButton}"
                            Content="&#xE103;" Margin="0,0,8,0"
                            VerticalAlignment="Center" Click="PlayPause_Click" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                        <Border x:Name="Bar0" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="Bar1" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="Bar2" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="Bar3" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="Bar4" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="Bar5" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="Bar6" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ============ EXPANDED VIEW ============ -->
            <Grid x:Name="ExpandedPanel" Margin="26,16,26,16"
                  VerticalAlignment="Center"
                  Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Date + time -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="DateText" Text="Monday, 1 January"
                               Foreground="{DynamicResource SubBrush}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TimeText" Text="00:00:00"
                               Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <!-- Media -->
                <Grid x:Name="MediaPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thumbnail (top-left) -->
                    <Border x:Name="AlbumHost" Grid.Row="0" Grid.Column="0" Width="72" Height="72" CornerRadius="14"
                            Cursor="Hand" ToolTip="Show player window"
                            MouseLeftButtonUp="Album_Click"
                            Background="#FF2C2C2E" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#x266B;" Foreground="#FF8E8E93" FontSize="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="AlbumArt" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Track title, artist, and visualizer -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Song name" Foreground="{DynamicResource TextBrush}"
                                   FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText" Text="Artist" Foreground="{DynamicResource SubBrush}"
                                   FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        <StackPanel x:Name="ExpandedVisualizerUnderArtist" Orientation="Horizontal"
                                    VerticalAlignment="Center" Height="16" Margin="0,7,0,0">
                            <Border x:Name="ExpBar0" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Border x:Name="ExpBar1" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Border x:Name="ExpBar2" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Border x:Name="ExpBar3" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Border x:Name="ExpBar4" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Border x:Name="ExpBar5" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Border x:Name="ExpBar6" Width="2" Height="2" CornerRadius="1"
                                    Background="#FF30D158" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="LyricsOffVisualizer" Grid.Row="0" Grid.Column="2"
                                Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Height="16" Visibility="Collapsed">
                        <Border x:Name="LyricsBar0" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="LyricsBar1" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="LyricsBar2" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="LyricsBar3" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="LyricsBar4" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="LyricsBar5" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border x:Name="LyricsBar6" Width="2" Height="2" CornerRadius="1"
                                Background="#FF30D158" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Current and upcoming lyric -->
                    <StackPanel x:Name="LyricsPanel" Grid.Row="0" Grid.Column="2"
                                VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="SyncedLyricsPanel">
                            <TextBlock x:Name="CurrentLyricText" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="42" />
                            <TextBlock x:Name="NextLyricText" Foreground="{DynamicResource SubBrush}"
                                       FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="36" Margin="0,6,0,0" />
                        </StackPanel>
                        <ScrollViewer x:Name="PlainLyricsScroll" Height="88" Margin="0,0,4,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <TextBlock x:Name="PlainLyricsText" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Controls, under the thumbnail -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,6,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE100;"
                                Width="24" Height="24" FontSize="12" Click="Prev_Click" />
                        <Button x:Name="PlayPauseBtn" Style="{StaticResource IconButton}"
                                Content="&#xE103;" Width="24" Height="24" FontSize="15" Click="PlayPause_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE101;"
                                Width="24" Height="24" FontSize="12" Click="Next_Click" />
                    </StackPanel>

                </Grid>

                <!-- Volume -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="VolumeBtn" Style="{StaticResource IconButton}"
                            Content="&#xE767;" Width="18" Height="18" FontSize="11"
                            Click="Mute_Click" />
                    <!-- Snaps in 2% steps; scroll the mouse wheel over the island for +/-2% -->
                    <Slider x:Name="VolumeSlider" Grid.Column="1"
                            Style="{StaticResource VolumeSlider}"
                            TickFrequency="2" IsSnapToTickEnabled="True"
                            SmallChange="2" LargeChange="2"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            ValueChanged="Volume_Changed" />
                    <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="0%"
                               Width="36" TextAlignment="Right"
                               Foreground="{DynamicResource SubBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Grid>

            <!-- ============ BORDER + PLAYBACK PROGRESS ============ -->
            <Path x:Name="TrackPath" IsHitTestVisible="False" StrokeLineJoin="Round" />
            <Path x:Name="ProgressPath" IsHitTestVisible="False"
                  StrokeLineJoin="Round" StrokeDashCap="Flat" Visibility="Collapsed" />
        </Grid>
    </Border>
    </Border>
</Window>
