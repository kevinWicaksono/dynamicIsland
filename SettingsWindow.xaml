<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FF1C1C1E" Foreground="White"
        FontFamily="Segoe UI" FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2" />
        <TextBlock x:Name="AboutText" FontSize="12" Foreground="#FF8E8E93" Margin="0,0,0,16" />

        <!-- Island size -->
        <DockPanel>
            <TextBlock x:Name="ScaleLabel" DockPanel.Dock="Right" Foreground="#FFB0B0B5" />
            <TextBlock Text="Island size" />
        </DockPanel>
        <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.6"
                TickFrequency="0.05" IsSnapToTickEnabled="True"
                Margin="0,4,0,14" ValueChanged="Scale_Changed" />

        <!-- Opacity -->
        <DockPanel>
            <TextBlock x:Name="CompactOpacityLabel" DockPanel.Dock="Right" Foreground="#FFB0B0B5" />
            <TextBlock Text="Opacity when collapsed" />
        </DockPanel>
        <Slider x:Name="CompactOpacitySlider" Minimum="30" Maximum="100"
                TickFrequency="5" IsSnapToTickEnabled="True"
                Margin="0,4,0,14" ValueChanged="CompactOpacity_Changed" />

        <DockPanel>
            <TextBlock x:Name="ExpandedOpacityLabel" DockPanel.Dock="Right" Foreground="#FFB0B0B5" />
            <TextBlock Text="Opacity when expanded" />
        </DockPanel>
        <Slider x:Name="ExpandedOpacitySlider" Minimum="30" Maximum="100"
                TickFrequency="5" IsSnapToTickEnabled="True"
                Margin="0,4,0,14" ValueChanged="ExpandedOpacity_Changed" />


        <!-- Position -->
        <DockPanel>
            <TextBlock x:Name="PosXLabel" DockPanel.Dock="Right" Foreground="#FFB0B0B5" />
            <TextBlock Text="Horizontal position" />
        </DockPanel>
        <Slider x:Name="PosXSlider" Minimum="0" Maximum="100"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Margin="0,4,0,6" ValueChanged="PosX_Changed" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Left" Padding="12,3" Margin="0,0,6,0" Click="PosLeft_Click" />
            <Button Content="Center" Padding="12,3" Margin="0,0,6,0" Click="PosCenter_Click" />
            <Button Content="Right" Padding="12,3" Click="PosRight_Click" />
        </StackPanel>

        <DockPanel>
            <TextBlock x:Name="PosYLabel" DockPanel.Dock="Right" Foreground="#FFB0B0B5" />
            <TextBlock Text="Distance from top" />
        </DockPanel>
        <Slider x:Name="PosYSlider" Minimum="0" Maximum="300"
                TickFrequency="5" IsSnapToTickEnabled="True"
                Margin="0,4,0,14" ValueChanged="PosY_Changed" />

        <!-- Border thickness -->
        <DockPanel>
            <TextBlock x:Name="ThicknessLabel" DockPanel.Dock="Right" Foreground="#FFB0B0B5" />
            <TextBlock Text="Border / progress thickness" />
        </DockPanel>
        <Slider x:Name="ThicknessSlider" Minimum="0" Maximum="8"
                TickFrequency="0.5" IsSnapToTickEnabled="True"
                Margin="0,4,0,14" ValueChanged="Thickness_Changed" />

        <!-- Border colour -->
        <TextBlock Text="Border / progress colour" />
        <DockPanel Margin="0,6,0,14">
            <TextBox x:Name="BorderHex" Tag="border" Width="86" DockPanel.Dock="Left"
                     Foreground="Black" VerticalAlignment="Top" TextChanged="Color_TextChanged" />
            <WrapPanel x:Name="BorderSwatches" Margin="10,0,0,0" />
        </DockPanel>

        <!-- Island colour -->
        <TextBlock Text="Island colour" />
        <DockPanel Margin="0,6,0,14">
            <TextBox x:Name="IslandHex" Tag="island" Width="86" DockPanel.Dock="Left"
                     Foreground="Black" VerticalAlignment="Top" TextChanged="Color_TextChanged" />
            <WrapPanel x:Name="IslandSwatches" Margin="10,0,0,0" />
        </DockPanel>

        <!-- Text colour -->
        <TextBlock Text="Text colour" />
        <DockPanel Margin="0,6,0,14">
            <TextBox x:Name="TextHex" Tag="text" Width="86" DockPanel.Dock="Left"
                     Foreground="Black" VerticalAlignment="Top" TextChanged="Color_TextChanged" />
            <WrapPanel x:Name="TextSwatches" Margin="10,0,0,0" />
        </DockPanel>

        <!-- Font -->
        <TextBlock Text="Font" />
        <ComboBox x:Name="FontBox" Margin="0,6,0,20" Foreground="Black"
                  SelectionChanged="Font_Changed" />

        <!-- Clock format -->
        <TextBlock Text="Clock format" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
            <RadioButton x:Name="Clock12" Content="12-hour (AM/PM)" GroupName="clock"
                         Foreground="White" Margin="0,0,22,0" Checked="Clock_Checked" />
            <RadioButton x:Name="Clock24" Content="24-hour" GroupName="clock"
                         Foreground="White" Checked="Clock_Checked" />
        </StackPanel>

        <!-- Lyrics -->
        <CheckBox x:Name="ShowLyricsCheckBox" Content="Show lyrics"
                  Foreground="White" Margin="0,0,0,4"
                  Checked="ShowLyrics_Changed" Unchecked="ShowLyrics_Changed" />
        <TextBlock Text="No sign-in is needed."
                   FontSize="11" Foreground="#FF8E8E93" TextWrapping="Wrap" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reset to defaults" Padding="14,6" Margin="0,0,8,0" Click="Reset_Click" />
            <Button Content="Done" Padding="22,6" IsDefault="True" Click="Done_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
