<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Width="460" Height="700" MinHeight="520" MaxHeight="900"
        ResizeMode="CanResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FF171719" Foreground="#FFF5F5F7"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9B9BA1" />
        <SolidColorBrush x:Key="CardBrush" Color="#FF222225" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF343438" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Foreground" Value="#FFF5F5F7" />
            <Setter Property="Background" Value="#FF343438" />
            <Setter Property="BorderBrush" Value="#FF45454A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="#FF171719" />
            <Setter Property="Foreground" Value="#FFF5F5F7" />
            <Setter Property="BorderBrush" Value="#FF45454A" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="#FF171719" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="2,0,0,4" />
                <TextBlock Text="Customize the island's appearance and behavior."
                           Foreground="{StaticResource MutedBrush}" Margin="2,0,0,18" />

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Layout" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <TextBlock x:Name="ScaleLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
                            <TextBlock Text="Island size" Style="{StaticResource SettingLabel}" />
                        </DockPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.6"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="Scale_Changed" />

                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <DockPanel>
                                    <TextBlock x:Name="CompactOpacityLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                    <TextBlock Text="Collapsed opacity" Style="{StaticResource SettingLabel}" />
                                </DockPanel>
                                <Slider x:Name="CompactOpacitySlider" Minimum="30" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="CompactOpacity_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DockPanel>
                                    <TextBlock x:Name="ExpandedOpacityLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                    <TextBlock Text="Expanded opacity" Style="{StaticResource SettingLabel}" />
                                </DockPanel>
                                <Slider x:Name="ExpandedOpacitySlider" Minimum="30" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="ExpandedOpacity_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Position" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <TextBlock x:Name="PosXLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
                            <TextBlock Text="Horizontal position" Style="{StaticResource SettingLabel}" />
                        </DockPanel>
                        <Slider x:Name="PosXSlider" Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,4,0,6" ValueChanged="PosX_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Left" Margin="0,0,8,0" Click="PosLeft_Click" />
                            <Button Content="Center" Margin="0,0,8,0" Click="PosCenter_Click" />
                            <Button Content="Right" Click="PosRight_Click" />
                        </StackPanel>

                        <DockPanel>
                            <TextBlock x:Name="PosYLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
                            <TextBlock Text="Distance from top" Style="{StaticResource SettingLabel}" />
                        </DockPanel>
                        <Slider x:Name="PosYSlider" Minimum="0" Maximum="300"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Margin="0,4,0,0" ValueChanged="PosY_Changed" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <TextBlock x:Name="ThicknessLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
                            <TextBlock Text="Border / progress thickness" Style="{StaticResource SettingLabel}" />
                        </DockPanel>
                        <Slider x:Name="ThicknessSlider" Minimum="0" Maximum="8"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                ValueChanged="Thickness_Changed" />

                        <TextBlock Text="Border / progress color" Style="{StaticResource SettingLabel}" Margin="0,2,0,4" />
                        <DockPanel Margin="0,0,0,10">
                            <TextBox x:Name="BorderHex" Tag="border" Width="78" DockPanel.Dock="Left"
                                     TextChanged="Color_TextChanged" />
                            <WrapPanel x:Name="BorderSwatches" Margin="10,2,0,0" />
                        </DockPanel>

                        <TextBlock Text="Island color" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,10">
                            <TextBox x:Name="IslandHex" Tag="island" Width="78" DockPanel.Dock="Left"
                                     TextChanged="Color_TextChanged" />
                            <WrapPanel x:Name="IslandSwatches" Margin="10,2,0,0" />
                        </DockPanel>

                        <TextBlock Text="Text color" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                        <DockPanel>
                            <TextBox x:Name="TextHex" Tag="text" Width="78" DockPanel.Dock="Left"
                                     TextChanged="Color_TextChanged" />
                            <WrapPanel x:Name="TextSwatches" Margin="10,2,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Font" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="FontBox" Margin="0,0,0,14"
                                  SelectionChanged="Font_Changed" />

                        <TextBlock Text="Clock format" Style="{StaticResource SettingLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                            <RadioButton x:Name="Clock12" Content="12-hour (AM/PM)" GroupName="clock"
                                         Foreground="White" Margin="0,0,22,0" Checked="Clock_Checked" />
                            <RadioButton x:Name="Clock24" Content="24-hour" GroupName="clock"
                                         Foreground="White" Checked="Clock_Checked" />
                        </StackPanel>

                        <CheckBox x:Name="ShowLyricsCheckBox" Content="Show lyrics"
                                  Foreground="White" Checked="ShowLyrics_Changed"
                                  Unchecked="ShowLyrics_Changed" />
                        <TextBlock Text="Lyrics are looked up online; no sign-in is needed."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="22,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,12,0,12">
            <DockPanel LastChildFill="False">
                <Button Content="Reset to defaults" DockPanel.Dock="Left"
                        Click="Reset_Click" />
                <Button Content="Done" DockPanel.Dock="Right" IsDefault="True" MinWidth="84"
                        Click="Done_Click" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="AboutText" Grid.Row="2" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                   HorizontalAlignment="Center" Margin="0,0,0,2" />
    </Grid>
</Window>
