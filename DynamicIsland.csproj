<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 TFM gives access to the media-session API (no NuGet / internet needed at runtime) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <!-- Shown in Settings. Change these when you release a new version. -->
    <Version>1.3.0</Version>
    <Product>Dynamic Island</Product>
    <Authors>Kevin Wicaksono</Authors>
    <Company>Kevin Wicaksono</Company>
  </PropertyGroup>

</Project>